[flake8]
# Project style, not the ament defaults.
#
# The stock ament config reported 1321 "errors" here, 974 of which were Q000:
# flake8-quotes objecting to double quotes. That is a preference, and this code
# is internally consistent, so the config is set to what the project actually
# does rather than the code being churned to match a default.
quotes = double
max-line-length = 120
import-order-style = google
application-import-names = grab_sequence

# D1xx  these are scripts and internal helpers, not a published API. Modules and
#       every non-obvious function carry docstrings; requiring one on each small
#       private helper is noise, and docs/DESIGN.md holds the reasoning.
# D213  summary-on-second-line. This project puts the summary on the first line,
#       which is D212 and equally valid.
# D401  imperative mood. Several docstrings deliberately open by naming the
#       thing returned rather than commanding.
# E114/E116  comment indentation. Constants here carry aligned continuation
#       comments under an inline comment, which is intentional and readable:
#           VISION_SETTLE = 2.0   # s to let the arm stop
#                                 # Was 4.0, and it is the largest cost in a trial
# I100/I201  import grouping is logical (stdlib, third-party, ROS, local) rather
#       than strictly alphabetical within groups.
# W503  line break before binary operator, which is the style black prefers.
extend-ignore = D100,D101,D102,D103,D104,D105,D107,D212,D213,D401,E114,E116,I100,I201,W503
exclude = .git,__pycache__,build,install,log,scripts/dev
