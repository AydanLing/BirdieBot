<?xml version="1.0" ?>
<!-- Badminton shuttlecock at BWF-legal dimensions.
       base (cork)      25-28 mm diameter   -> 26 mm here
       feather crown    58-68 mm tip circle -> 65 mm here
       overall length   ~85 mm              -> 85 mm here
       mass             4.74-5.50 g         -> 5.0 g here
     The skirt is a real truncated cone, flaring 26 mm to 65 mm over 60 mm,
     generated by make_skirt_mesh.py. sdformat 14 has no cone primitive, hence
     the mesh. It is solid and closed so it stays convex for collision.
     Mass sits low in the cork, as on a real shuttle, so it stands cork-down.
     Yellow so the existing HSV detector in grasp_ball finds it. -->
<sdf version="1.9">
  <model name="shuttlecock">
    <pose>0 0 0 0 0 0</pose>
    <link name="body">
      <inertial>
        <pose>0 0 0.022 0 0 0</pose>
        <mass>0.005</mass>
        <inertia>
          <ixx>4.33e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.33e-6</iyy>
          <iyz>0</iyz>
          <izz>2.64e-6</izz>
        </inertia>
      </inertial>

      <!-- Cork base, 26 mm dia, z = 0 .. 0.025. Flat-bottomed cylinder rather
           than a hemisphere: a real cork has a small flat contact patch and
           stands upright, whereas a true 13 mm sphere with the centre of mass
           22 mm up is statically unstable and topples. -->
      <collision name="cork">
        <pose>0 0 0.0125 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.013</radius><length>0.025</length></cylinder>
        </geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
          <bounce><restitution_coefficient>0.1</restitution_coefficient></bounce>
        </surface>
      </collision>
      <visual name="cork_visual">
        <pose>0 0 0.0125 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.013</radius><length>0.025</length></cylinder>
        </geometry>
        <material>
          <ambient>0.75 0.68 0.15 1</ambient>
          <diffuse>0.95 0.85 0.15 1</diffuse>
        </material>
      </visual>

      <!-- conical feather skirt, z = 0.025 .. 0.085 -->
      <collision name="skirt">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <mesh><uri>model://shuttlecock/meshes/skirt.stl</uri></mesh>
        </geometry>
        <surface>
          <friction><ode><mu>0.9</mu><mu2>0.9</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="skirt_visual">
        <pose>0 0 0.025 0 0 0</pose>
        <geometry>
          <mesh><uri>model://shuttlecock/meshes/skirt.stl</uri></mesh>
        </geometry>
        <material>
          <ambient>0.80 0.75 0.20 1</ambient>
          <diffuse>1.0 0.95 0.25 1</diffuse>
        </material>
      </visual>

      <!-- A perfect primitive on a flat plane never stops without rolling
           resistance, so damp it and let it settle where it is placed. -->
      <velocity_decay>
        <linear>0.6</linear>
        <angular>1.2</angular>
      </velocity_decay>
    </link>
  </model>
</sdf>
